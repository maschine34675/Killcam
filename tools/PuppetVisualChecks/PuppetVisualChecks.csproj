<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <VisualHierarchySource Condition="'$(VisualHierarchySource)' == ''">../../src/Replay/PuppetVisualHierarchy.cs</VisualHierarchySource>
    <PuppetSource Condition="'$(PuppetSource)' == ''">../../src/Replay/GhostPuppet.cs</PuppetSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(VisualHierarchySource)" Link="Production/PuppetVisualHierarchy.cs" />
    <Compile Include="$(PuppetSource)" Link="Production/GhostPuppet.cs" />
    <Compile Include="../../src/Replay/WeaponMeshCollector.cs" Link="Production/WeaponMeshCollector.cs" />
  </ItemGroup>
</Project>
