<Project>
  <PropertyGroup>
    <Version>1.0.1</Version>
    <SPTPath>$(MSBuildThisFileDirectory)..\..</SPTPath>
    <AssemblySearchPaths>
      $(SPTPath)\EscapeFromTarkov_Data\Managed;
      $(SPTPath)\BepInEx\plugins\spt;
      $(AssemblySearchPaths)
    </AssemblySearchPaths>
  </PropertyGroup>

  <Import Project="Shared.props.user" Condition="Exists('Shared.props.user')" />

  <Target Name="SPTClientDeploy" AfterTargets="PostBuildEvent" Condition="'$(SPTModType)'=='Client'">
    <Exec Command='pwsh -NoProfile -File "$(MSBuildThisFileDirectory)tools\Deploy-Killcam.ps1" -AssemblyPath "$(TargetPath)" -SptPath "$(SPTPath)" -Configuration "$(Configuration)"' />
  </Target>
</Project>
